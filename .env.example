NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true
JWT_SECRET=
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

RESEND_API_KEY=re_sua_chave
EMAIL_FROM=onboarding@resend.dev

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=nome-do-seu-bucket
B2_QUARANTINE_BUCKET_NAME=nome-do-bucket-quarentena
B2_APPLICATION_KEY_ID=sua-application-key-id
B2_APPLICATION_KEY=sua-application-key
B2_PUBLIC_BASE_URL=https://f005.backblazeb2.com/file/nome-do-seu-bucket
GOOGLE_APPLICATION_CREDENTIALS=src/config/google/timetolearn-vision-api-fe659a4b44d8.json

# Mercado Pago - conta da plataforma
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Mercado Pago Marketplace OAuth - vendedores professores
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/marketplace/seller/oauth/callback
# 32 bytes em hexadecimal (64 caracteres); mantenha a mesma chave em todos os deploys.
MERCADO_PAGO_TOKEN_ENCRYPTION_KEY=
MARKETPLACE_COMMISSION_PERCENT=20

# Ferramentas para gerar prévias do Marketplace (Windows: informe caminhos se não estiverem no PATH)
# Exemplo: LIBREOFFICE_PATH=C:\\Program Files\\LibreOffice\\program\\soffice.exe
# Exemplo: PDFINFO_PATH=C:\\tools\\poppler\\Library\\bin\\pdfinfo.exe
# Exemplo: PDFTOPPM_PATH=C:\\tools\\poppler\\Library\\bin\\pdftoppm.exe
LIBREOFFICE_PATH=
PDFINFO_PATH=
PDFTOPPM_PATH=

TEACHER_STORAGE_LIMIT_BYTES=524288000
